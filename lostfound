<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ของหายได้คืน | สารวัตรนักเรียน</title>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&family=Prompt:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'media', theme: { extend: { fontFamily: { kanit: ['Kanit'], prompt: ['Prompt'] } } } }</script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-kanit">

    <nav class="w-full p-4 relative z-10">
        <a href="/" class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-800 px-5 py-2.5 rounded-full shadow-sm border border-slate-200 dark:border-slate-700 hover:text-blue-600 transition-colors">
            <i class="fa-solid fa-arrow-left"></i> กลับหน้าหลัก
        </a>
    </nav>

    <main class="max-w-4xl mx-auto p-4 pt-8">
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-blue-100 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400 rounded-3xl flex items-center justify-center text-4xl mx-auto mb-5 shadow-lg"><i class="fa-solid fa-box-open"></i></div>
            <h1 class="text-3xl md:text-4xl font-prompt font-bold mb-2">ของหายได้คืน (Lost & Found)</h1>
            <p class="text-slate-500 dark:text-slate-400">แจ้งของหาย หรือ ค้นหาของที่เก็บได้ พร้อมระบบขอรับคืน</p>
        </div>

        <div class="bg-white dark:bg-slate-800 p-6 md:p-8 rounded-[2rem] shadow-xl border-t-4 border-blue-500 mb-12">
            <h2 class="text-2xl font-prompt font-bold mb-6 border-b border-slate-200 dark:border-slate-700 pb-4">แบบฟอร์มแจ้งเก็บของได้</h2>
            <form id="lf-form" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block mb-2 font-medium">ชื่อสิ่งของ <span class="text-red-500">*</span></label>
                        <input type="text" id="lf-name" required class="w-full px-5 py-4 rounded-xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all dark:text-white" placeholder="เช่น กุญแจรถ, กระเป๋าตังค์">
                    </div>
                    <div>
                        <label class="block mb-2 font-medium">สถานที่พบ <span class="text-red-500">*</span></label>
                        <input type="text" id="lf-location" required class="w-full px-5 py-4 rounded-xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all dark:text-white" placeholder="ระบุสถานที่">
                    </div>
                </div>

                <div>
                    <label class="block mb-2 font-medium">ภาพประกอบ (อัปโหลดลง Google Drive อัตโนมัติ) <span class="text-red-500">*</span></label>
                    <div class="relative w-full py-8 rounded-xl border-2 border-dashed border-blue-300 dark:border-blue-700 bg-blue-50 dark:bg-blue-900/10 text-center hover:bg-blue-100 transition-colors">
                        <input type="file" id="lf-img" accept="image/*" capture="environment" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" onchange="previewLF(this)">
                        <i class="fa-solid fa-camera text-4xl text-blue-500 mb-3"></i>
                        <p id="lf-img-txt" class="text-blue-600 dark:text-blue-400 font-bold">คลิกเพื่อเปิดกล้อง หรือเลือกไฟล์</p>
                    </div>
                    <img id="lf-preview" class="hidden w-full h-56 object-cover rounded-xl mt-4 border border-slate-200 shadow-sm">
                </div>

                <button type="submit" id="lf-btn" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-lg shadow-[0_4px_15px_rgba(37,99,235,0.4)] transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-cloud-arrow-up"></i> บันทึกข้อมูลและอัปโหลดรูปภาพ
                </button>
            </form>
        </div>

        <h2 class="text-3xl font-prompt font-bold mb-6 text-center">รายการของที่รอเจ้าของมารับ</h2>
        <div id="lf-gallery" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="col-span-full text-center py-10 text-blue-500"><i class="fa-solid fa-circle-notch fa-spin text-4xl"></i><p class="mt-4">กำลังโหลดข้อมูล...</p></div>
        </div>
    </main>

    <!-- Firebase SDK (Modular v11.6.1) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs, query, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyBTHk57HCEZgn8ydldHjOaFxVgy1Xtlpk8",
            authDomain: "sarawatdc.firebaseapp.com",
            projectId: "sarawatdc",
            messagingSenderId: "403581597525",
            appId: "1:403581597525:web:6fd3f19a881a0ca42661dc"
        };
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        
        // Google Apps Script Web App URL
        const GAS_WEBAPP_URL = "https://script.google.com/macros/s/AKfycbxQpKRlYoeM9u8epd6U-sDHZp3QMddu7q0vyyC61toIhWdex5SiebhTSXot-lawS_A/exec";
        let lfFile = null;

        // Image Preview
        window.previewLF = (input) => {
            if(input.files && input.files[0]){
                lfFile = input.files[0];
                const r = new FileReader();
                r.onload = e => { 
                    document.getElementById('lf-preview').src = e.target.result; 
                    document.getElementById('lf-preview').classList.remove('hidden'); 
                    document.getElementById('lf-img-txt').innerText = 'เลือกรูปภาพแล้ว (แตะเพื่อเปลี่ยนรูป)'; 
                };
                r.readAsDataURL(lfFile);
            }
        };

        // Upload to Drive via Apps Script
        async function uploadImageToDrive(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = async () => {
                    const base64 = reader.result.split(',')[1];
                    try {
                        const response = await fetch(GAS_WEBAPP_URL, {
                            method: "POST",
                            body: JSON.stringify({ filename: file.name, mimeType: file.type, base64: base64 })
                        });
                        const result = await response.json();
                        if(result.success) resolve(result.viewUrl);
                        else reject(result.error);
                    } catch(e) { reject("อัปโหลดรูปล้มเหลว"); }
                };
                reader.onerror = () => reject("อ่านไฟล์ไม่สำเร็จ");
                reader.readAsDataURL(file);
            });
        }

        // Submit Form
        document.getElementById('lf-form').addEventListener('submit', async (e) => {
            e.preventDefault(); 
            const btn = document.getElementById('lf-btn'); const origText = btn.innerHTML;
            btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> อัปโหลดรูปภาพลง Google Drive...';
            
            try {
                if(!lfFile) throw new Error("กรุณาเลือกรูปภาพสิ่งของ");
                const driveUrl = await uploadImageToDrive(lfFile);

                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึกข้อมูล...';
                await addDoc(collection(db, "lost_found"), { 
                    itemName: document.getElementById('lf-name').value, 
                    location: document.getElementById('lf-location').value, 
                    imageUrl: driveUrl, 
                    status: 'unclaimed', 
                    createdAt: serverTimestamp() 
                });

                Swal.fire({ title: 'บันทึกสำเร็จ', text: 'ของที่เก็บได้ถูกเพิ่มเข้าระบบแล้ว', icon: 'success' });
                document.getElementById('lf-form').reset(); 
                lfFile = null; document.getElementById('lf-preview').classList.add('hidden'); document.getElementById('lf-img-txt').innerText = 'คลิกเพื่อเปิดกล้อง หรือเลือกไฟล์';
                loadGallery();
            } catch(err) { Swal.fire('Error', err.toString(), 'error'); } 
            finally { btn.disabled = false; btn.innerHTML = origText; }
        });

        // Load Gallery
        async function loadGallery() {
            const gal = document.getElementById('lf-gallery');
            try {
                const q = query(collection(db, "lost_found"), orderBy("createdAt", "desc"));
                const snap = await getDocs(q);
                if(snap.empty) {
                    gal.innerHTML = '<div class="col-span-full text-center py-10 text-slate-500 bg-white dark:bg-slate-800 rounded-2xl shadow">ยังไม่มีการแจ้งของหาย</div>';
                    return;
                }
                gal.innerHTML = '';
                snap.forEach(doc => {
                    const d = doc.data();
                    if(d.status === 'unclaimed') {
                        const date = d.createdAt ? d.createdAt.toDate().toLocaleDateString('th-TH') : '';
                        gal.insertAdjacentHTML('beforeend', `
                            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 overflow-hidden flex flex-col hover:-translate-y-1 transition-transform">
                                <img src="${d.imageUrl}" class="w-full h-48 object-cover cursor-pointer" onclick="window.open('${d.imageUrl}')">
                                <div class="p-5 flex-grow flex flex-col">
                                    <div class="flex justify-between items-start mb-3">
                                        <h3 class="font-bold text-lg leading-tight line-clamp-2">${d.itemName}</h3>
                                        <span class="bg-blue-100 text-blue-600 dark:bg-blue-500/20 dark:text-blue-400 px-2 py-1 rounded-full text-[10px] font-bold shrink-0">รอเจ้าของ</span>
                                    </div>
                                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-1"><i class="fa-solid fa-location-dot w-4"></i> พบที่: ${d.location}</p>
                                    <p class="text-xs text-slate-400 mb-4"><i class="fa-regular fa-clock w-4"></i> ${date}</p>
                                    <button class="w-full mt-auto py-2.5 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl font-bold hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors text-sm">ติดต่อขอรับคืน</button>
                                </div>
                            </div>
                        `);
                    }
                });
            } catch(e) { console.error(e); }
        }
        loadGallery();
    </script>
</body>
</html>
